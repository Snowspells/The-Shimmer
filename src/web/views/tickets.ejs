<%- include('partials/header', { title: 'Live Communication', user }) %>

<div class="tickets-page">
    <div class="page-header">
        <h1>Live Communication</h1>
        <div class="filter-bar">
            <a href="/tickets" class="btn btn-sm <%= !currentFilter ? 'btn-primary' : '' %>">All</a>
            <a href="/tickets?status=open" class="btn btn-sm <%= currentFilter === 'open' ? 'btn-primary' : '' %>">Open</a>
            <a href="/tickets?status=closed" class="btn btn-sm <%= currentFilter === 'closed' ? 'btn-primary' : '' %>">Closed</a>
        </div>
    </div>

    <% const activeTicket = tickets.find(ticket =>
        ticket.ticket_mode === 'dm' && ticket.status === 'open' && ticket.creator_id === user.id
    ); %>
    <section class="ticket-entry-section admin-section">
        <h2>Start a conversation</h2>
        <% if (activeTicket) { %>
            <p>You already have an open ticket. Continue that conversation before opening another.</p>
            <a class="btn btn-primary" href="/tickets/<%= activeTicket.id %>">Continue Ticket #<%= activeTicket.id %></a>
        <% } else { %>
            <p>A support ticket opens a private Discord DM with the bot. You can also read and reply here.</p>
            <form method="post" action="/tickets" class="suggestion-form">
                <label for="ticket-subject">What do you need help with?</label>
                <input id="ticket-subject" name="subject" type="text" maxlength="150" placeholder="Brief subject" required>
                <button type="submit" class="btn btn-primary">Open Ticket</button>
            </form>
        <% } %>
    </section>

    <section class="admin-section">
        <h2>Your Ticket History</h2>
        <% if (tickets.length > 0) { %>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Subject</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Conversation</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% tickets.forEach(function(ticket) { %>
                            <tr>
                                <td data-label="ID"><code>#<%= ticket.id %></code></td>
                                <td data-label="Subject"><%= ticket.subject %></td>
                                <td data-label="Status"><span class="ticket-status ticket-<%= ticket.status %>"><%= ticket.status %></span></td>
                                <td data-label="Created"><%- timeTag(ticket.created_at) %></td>
                                <td data-label="Conversation">
                                    <% if (ticket.ticket_mode === 'dm' && ticket.status === 'open') { %>
                                        <a href="/tickets/<%= ticket.id %>" class="btn btn-sm btn-primary">Continue</a>
                                    <% } else if (ticket.ticket_mode === 'dm' || ticket.status === 'closed') { %>
                                        <a href="/tickets/<%= ticket.id %>/transcript" class="btn btn-sm">View transcript</a>
                                    <% } else { %>
                                        <span class="text-muted">Archived channel ticket</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="empty-state"><p>No tickets found<%= currentFilter ? ` with status "${currentFilter}"` : '' %>.</p></div>
        <% } %>
    </section>
</div>

<%- include('partials/footer') %>
