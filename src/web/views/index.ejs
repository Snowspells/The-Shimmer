<%- include('partials/header', { title: 'Home', user }) %>

<div class="hero">
    <h1>The Shimmer</h1>
    <p class="hero-subtitle">The Shimmer Beckons. The Shimmer Nurtures. The Shimmer Watches.</p>
    <div class="hero-description">
        <p>Keeper of the Shimmer</p>
    </div>
    <% if (!user) { %>
        <a href="/auth/login" class="btn btn-primary btn-lg">Login with Discord</a>
    <% } else { %>
        <a href="/dashboard" class="btn btn-primary btn-lg">Go to Dashboard</a>
    <% } %>
</div>

<div class="features">
    <div class="feature-card">
        <h3>Account Linking</h3>
        <p>Link your Discord account to your AGID. Track your marks, inventory, and progress all in one place.</p>
    </div>
    <div class="feature-card">
        <h3>Account Control</h3>
        <p>A central place to manage your inventory, track your progress, assign your loadout, and more.</p>
    </div>
    <div class="feature-card">
        <h3>Global Chat</h3>
        <p>Stay connected with the community while you track your inventory and progress.</p>
    </div>
</div>

<%- include('partials/footer') %>
