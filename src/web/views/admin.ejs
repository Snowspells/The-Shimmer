<%- include('partials/header', { title: 'Staff Panel', user }) %>

<div class="admin">
    <div class="admin-header">
        <h1>Staff Panel</h1>
        <span class="staff-badge staff-level-<%= user.staffLevel %>"><%= user.staffLabel %></span>
    </div>
    <%- include('partials/admin-nav', { active: 'overview', permissions }) %>

    <div class="stats-grid">
        <% if (permissions.canManageServer) { %>
        <div class="stat-card">
            <h3>Linked Users</h3>
            <p class="stat-value"><%= stats.totalUsers %></p>
        </div>
        <% } %>
        <% if (permissions.canManageTickets) { %>
        <div class="stat-card">
            <h3>Open Tickets</h3>
            <p class="stat-value"><%= stats.openTickets %></p>
        </div>
        <% } %>
        <div class="stat-card">
            <h3>Servers</h3>
            <p class="stat-value"><%= stats.botGuilds %></p>
        </div>
        <div class="stat-card">
            <h3>Bot Uptime</h3>
            <p class="stat-value"><%= stats.botUptime %></p>
        </div>
    </div>

    <div class="stats-grid">
        <% if (permissions.canKickPlayers || permissions.canBanPlayers || permissions.canMutePlayers) { %>
        <a class="stat-card" href="/admin/server"><h3>Server Controls</h3><p>Live players, announcements, kick, mute and ban.</p></a>
        <% } %>
        <% if (permissions.canManageServer) { %>
        <a class="stat-card" href="/admin/users"><h3>Linked Users</h3><p>Review and edit linked accounts.</p></a>
        <% } %>
        <% if (permissions.canManageTickets) { %>
        <a class="stat-card" href="/admin/tickets"><h3>Ticket Management</h3><p>Ticket inbox, stats and responses.</p></a>
        <% } %>
        <% if (permissions.canManageChat) { %>
        <a class="stat-card" href="/admin/chat"><h3>Chat Moderation</h3><p>Web chat mutes and bridge log.</p></a>
        <% } %>
        <% if (permissions.canRefreshCommands) { %>
        <a class="stat-card" href="/admin/reaction-roles"><h3>Reaction Roles</h3><p>Manage reaction role posts.</p></a>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>
