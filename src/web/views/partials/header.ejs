<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>The Shimmer</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/local-time.js" defer></script>
</head>
<body>
    <nav class="navbar">
        <div class="nav-links">
            <a href="/">Home</a>
            <% if (user) { %>
            <a href="/dashboard">Dashboard</a>
            <a href="/tickets">Live Communication</a>
                <% if (typeof isLinkedMember !== 'undefined' && isLinkedMember) { %>
                    <a href="/suggestions">Suggestions</a>
                    <a href="/echo">Echoes</a>
                    <a href="/shop">Shop</a>
                    <a href="/infractions">Infractions</a>
                <% } %>
                <% if (typeof isLinkedMember !== 'undefined' && isLinkedMember) { %>
                    <a href="/bugs">Bug Tracker</a>
                <% } %>
                <% if (user.webPermissions?.canViewStaffPanel) { %>
                    <a href="/admin">Staff Panel</a>
                    <span class="staff-badge staff-level-<%= user.staffLevel %>"><%= user.staffLabel %></span>
                <% } %>
                <div class="nav-user">
                    <%- include('notifications') %>
                    <img src="<%= user.avatar
                        ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=32`
                        : `https://cdn.discordapp.com/embed/avatars/${parseInt(user.id) % 5}.png` %>"
                        alt="avatar" class="nav-avatar">
                    <span><%= user.displayName || user.username %></span>
                    <a href="/auth/logout" class="btn btn-sm">Logout</a>
                </div>
            <% } else { %>
                <a href="/auth/login" class="btn btn-primary">Login with Discord</a>
            <% } %>
        </div>
    </nav>
    <div class="page-shell">
    <% if (user && (aiChatChannelConfigured || (staffChatConfigured && (user.staffLevel || 0) >= 1))) { %>
        <%- include('mini-chat', { user }) %>
    <% } %>
    <main class="container">
