<div id="notification-bar" class="notification-bar" aria-busy="true">
    <button id="notification-toggle" class="notification-toggle" type="button" aria-expanded="false" aria-controls="notification-panel">
        Updates <span id="notification-badge" class="notification-badge" hidden></span>
    </button>
    <section id="notification-panel" class="notification-panel" aria-label="Unread updates" hidden>
    <div class="notification-bar-header">
        <strong>Updates</strong>
        <span id="notification-total" aria-live="polite">Loading…</span>
    </div>
    <div id="notification-counts" class="notification-counts"></div>
    <nav id="notification-events" class="notification-events" aria-label="Recent unread updates"></nav>
    <button id="notification-load-more" class="notification-load-more" type="button" hidden>
        Load older updates
    </button>
    <p id="notification-error" class="notification-error" role="status" hidden></p>
    </section>
</div>
<script src="/js/notifications.js" defer></script>
